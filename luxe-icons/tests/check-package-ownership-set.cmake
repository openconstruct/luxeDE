if(NOT ICON_PACKAGE OR NOT ARTIFACTS_DIR OR NOT OWNERSHIP_FILE)
  message(FATAL_ERROR "ICON_PACKAGE, ARTIFACTS_DIR and OWNERSHIP_FILE are required")
endif()
file(READ "${OWNERSHIP_FILE}" ownership_json)
string(JSON owner_count LENGTH "${ownership_json}" fallback_owners)
math(EXPR owner_last "${owner_count} - 1")
set(owner_pairs)
foreach(index RANGE 0 ${owner_last})
  string(JSON alias MEMBER "${ownership_json}" fallback_owners ${index})
  string(JSON owner GET "${ownership_json}" fallback_owners "${alias}")
  if(owner STREQUAL "legacy-external" OR owner STREQUAL "luxe-icons")
    continue()
  endif()
  file(GLOB packages "${ARTIFACTS_DIR}/${owner}_*.deb")
  list(LENGTH packages package_count)
  if(NOT package_count EQUAL 1)
    message(FATAL_ERROR "Expected one current DEB for fallback owner ${owner}; found ${package_count}")
  endif()
  list(GET packages 0 package)
  list(APPEND owner_pairs "${owner}|${alias}|${package}")
endforeach()
execute_process(COMMAND bash "${CMAKE_CURRENT_LIST_DIR}/check-package-ownership-set.sh"
  "${ICON_PACKAGE}" ${owner_pairs}
  RESULT_VARIABLE result)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Installed package ownership audit failed")
endif()
