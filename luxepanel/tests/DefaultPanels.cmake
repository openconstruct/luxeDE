cmake_minimum_required(VERSION 3.25)
if(NOT IS_DIRECTORY "${SOURCE_ROOT}")
  message(FATAL_ERROR "Pass -DSOURCE_ROOT=<luxepanel source>")
endif()
set(known space dclock wincmd taskbar launchtaskbar menu notifications tray dirmenu
  launchbar volume cpu deskno batt kbled xkb thermal cpufreq monitors separator)
foreach(relative data/default/panels/panel data/default/panels/panel.in
    data/two_panels/panels/top data/two_panels/panels/bottom)
  set(path "${SOURCE_ROOT}/${relative}")
  file(READ "${path}" text)
  string(REGEX MATCHALL "(^|[^A-Za-z0-9_])type[ \t\r\n]*=[ \t\r\n]*[A-Za-z0-9_+-]+" plugins "${text}")
  foreach(plugin IN LISTS plugins)
    string(REGEX REPLACE ".*=[ \t\r\n]*" "" name "${plugin}")
    if(NOT name IN_LIST known)
      message(FATAL_ERROR "${path}: unavailable plugin ${name}")
    endif()
  endforeach()
  string(REGEX MATCHALL "(@prefix@|/usr)/share/luxepanel/images/[^ \t\r\n\"']+" images "${text}")
  foreach(image IN LISTS images)
    string(REGEX REPLACE "^(@prefix@|/usr)/share/luxepanel/images/" "" name "${image}")
    if(NOT EXISTS "${SOURCE_ROOT}/data/images/${name}" OR IS_DIRECTORY "${SOURCE_ROOT}/data/images/${name}")
      message(FATAL_ERROR "${path}: missing packaged image ${name}")
    endif()
  endforeach()
endforeach()
message(STATUS "PASS: four default panel files reference available plugins and images")
