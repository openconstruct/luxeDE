<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
	<schema path="/org/luxe/luxepower/" id="org.luxe.LuxePower">
		<key name="lock-enabled" type="b">
			<default>true</default>
		</key>
		<key name="lock-minutes" type="u">
			<range min="1" max="1440"/>
			<default>15</default>
		</key>
		<key name="idle-lock-failed" type="b">
			<default>false</default>
		</key>
	</schema>
</schemalist>
