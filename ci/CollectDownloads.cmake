cmake_minimum_required(VERSION 3.25)
if(NOT IS_DIRECTORY "${DOWNLOAD_DIRECTORY}" OR NOT DEFINED OUTPUT_DIRECTORY)
  message(FATAL_ERROR "Pass -DDOWNLOAD_DIRECTORY=<downloads> -DOUTPUT_DIRECTORY=<cohort>")
endif()
include("${CMAKE_CURRENT_LIST_DIR}/../cmake/LuxeComponents.cmake")
file(GLOB_RECURSE packages LIST_DIRECTORIES FALSE "${DOWNLOAD_DIRECTORY}/*.deb")
list(SORT packages)
set(names)
foreach(package IN LISTS packages)
  execute_process(COMMAND dpkg-deb -f "${package}" Package OUTPUT_VARIABLE name
    OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
  if(NOT name IN_LIST LUXE_COMPONENTS OR name IN_LIST names)
    message(FATAL_ERROR "Unexpected or duplicate package: ${name}")
  endif()
  get_filename_component(directory "${package}" DIRECTORY)
  get_filename_component(filename "${package}" NAME)
  file(STRINGS "${directory}/SHA256SUMS" lines)
  set(expected "")
  foreach(line IN LISTS lines)
    if(line MATCHES "^([0-9a-fA-F]+) +[* ]?(.+)$")
      if(CMAKE_MATCH_2 STREQUAL filename)
        set(expected "${CMAKE_MATCH_1}")
      endif()
    endif()
  endforeach()
  file(SHA256 "${package}" actual)
  if(NOT actual STREQUAL expected)
    message(FATAL_ERROR "Checksum mismatch: ${package}")
  endif()
  list(APPEND names "${name}")
  set(package_${name} "${package}")
endforeach()
foreach(name IN LISTS LUXE_COMPONENTS)
  if(NOT name IN_LIST names)
    message(FATAL_ERROR "Missing package: ${name}")
  endif()
endforeach()
execute_process(COMMAND mktemp -d OUTPUT_VARIABLE scratch OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
foreach(name IN LISTS names)
  file(MAKE_DIRECTORY "${scratch}/${name}/packages")
  file(COPY "${package_${name}}" DESTINATION "${scratch}/${name}/packages")
endforeach()
execute_process(COMMAND "${CMAKE_COMMAND}" "-DINPUT_ROOT=${scratch}"
  "-DARTIFACT_ROOT=${OUTPUT_DIRECTORY}" -P "${CMAKE_CURRENT_LIST_DIR}/../cmake/CollectArtifacts.cmake"
  RESULT_VARIABLE result)
file(REMOVE_RECURSE "${scratch}")
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Cohort collection failed")
endif()
