cmake_minimum_required(VERSION 3.25)
include("${CMAKE_CURRENT_LIST_DIR}/../cmake/LuxeComponents.cmake")
if(NOT DEFINED OUTPUT)
  message(FATAL_ERROR "Pass -DOUTPUT=<matrix.json>")
endif()
if(DEFINED COMPONENT AND NOT COMPONENT STREQUAL "all")
  if(NOT COMPONENT IN_LIST LUXE_COMPONENTS)
    message(FATAL_ERROR "Unknown Luxe component: ${COMPONENT}")
  endif()
  set(LUXE_COMPONENTS "${COMPONENT}")
endif()
list(JOIN LUXE_COMPONENTS "\",\"" names)
file(WRITE "${OUTPUT}" "{\"component\":[\"${names}\"],\"distribution\":[{\"id\":\"ubuntu-24.04\",\"image\":\"ubuntu:24.04\"},{\"id\":\"debian-13\",\"image\":\"debian:13\"}]}\n")
