<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="lucid-gruvbox-light-medium" _name="Gruvbox light, medium" version="1.0">
  <author>Dawid Kurek (dawikur@gmail.com), morhetz (https://github.com/morhetz/gruvbox)</author>
  <description>Lucid adaptation of the Tinted Theming palette.</description>
  <metadata><property name="variant">light</property><property name="terminal-palette">#fbf1c7 #9d0006 #79740e #b57614 #076678 #8f3f71 #427b58 #504945 #bdae93 #9d0006 #79740e #b57614 #076678 #8f3f71 #427b58 #282828</property></metadata>
  <color name="base00" value="#fbf1c7"/>
  <color name="base01" value="#ebdbb2"/>
  <color name="base02" value="#d5c4a1"/>
  <color name="base03" value="#bdae93"/>
  <color name="base04" value="#665c54"/>
  <color name="base05" value="#504945"/>
  <color name="base06" value="#3c3836"/>
  <color name="base07" value="#282828"/>
  <color name="base08" value="#9d0006"/>
  <color name="base09" value="#af3a03"/>
  <color name="base0A" value="#b57614"/>
  <color name="base0B" value="#79740e"/>
  <color name="base0C" value="#427b58"/>
  <color name="base0D" value="#076678"/>
  <color name="base0E" value="#8f3f71"/>
  <color name="base0F" value="#d65d0e"/>
  <color name="comment" value="#665c54"/>
  <style name="text" foreground="base05" background="base00"/>
  <style name="selection" foreground="base05" background="base02"/>
  <style name="selection-unfocused" foreground="base05" background="base02"/>
  <style name="cursor" foreground="base05"/>
  <style name="secondary-cursor" foreground="base08"/>
  <style name="current-line" background="base01"/>
  <style name="line-numbers" foreground="base04" background="base00"/>
  <style name="current-line-number" bold="true" foreground="base0D" background="base01"/>
  <style name="right-margin" foreground="base03" background="base01"/>
  <style name="draw-spaces" foreground="base03"/>
  <style name="search-match" foreground="base00" background="base0A"/>
  <style name="bracket-match" bold="true" foreground="base00" background="base0C"/>
  <style name="bracket-mismatch" foreground="base00" background="base08"/>
  <style name="def:comment" foreground="comment"/>
  <style name="def:shebang" foreground="comment"/>
  <style name="def:doc-comment" foreground="comment"/>
  <style name="def:string" foreground="base0B"/>
  <style name="def:special-char" foreground="base0C"/>
  <style name="def:number" foreground="base09"/>
  <style name="def:floating-point" foreground="base09"/>
  <style name="def:decimal" foreground="base09"/>
  <style name="def:base-n-integer" foreground="base09"/>
  <style name="def:boolean" foreground="base09"/>
  <style name="def:constant" foreground="base09"/>
  <style name="def:keyword" foreground="base0E"/>
  <style name="def:statement" foreground="base0E"/>
  <style name="def:type" foreground="base0A"/>
  <style name="def:function" foreground="base0D"/>
  <style name="def:identifier" foreground="base05"/>
  <style name="def:preprocessor" foreground="base0C"/>
  <style name="def:operator" foreground="base0C"/>
  <style name="def:special-constant" foreground="base08"/>
  <style name="def:note" foreground="base0A"/>
  <style name="def:net-address" foreground="base0D"/>
  <style name="def:error" foreground="base08"/>
</style-scheme>
