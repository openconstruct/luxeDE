# LuxeDM supplies the native Lumen lock screen and PAM authentication path.
if command -v luxedm-lock >/dev/null 2>&1; then
    exec luxedm-lock "$@"
fi

# External lockers retain manual compatibility, but their spawn/exit status
# does not establish the native readiness contract required before sleep.
if [ "$#" -ne 0 ] && [ "$1" = "--ready-fd" ]; then
    printf '%s\n' 'luxelock: a readiness-capable native locker is required for this action' >&2
    exit 1
fi

# LightDM remains a supported fallback for Luxe installed on existing systems.
if [ -n "${XDG_SEAT_PATH:-}" ] && command -v dm-tool >/dev/null 2>&1; then
    if dm-tool lock >/dev/null 2>&1; then
        exit 0
    fi
fi

# Keep the inherited locker fallbacks so Luxe remains usable with other
# display managers and in sessions launched without one.
if command -v pidof >/dev/null 2>&1 && pidof light-locker >/dev/null 2>&1; then
    exec light-locker-command -l
fi
if command -v pidof >/dev/null 2>&1 && pidof xscreensaver >/dev/null 2>&1; then
    exec xscreensaver-command -lock
fi
if command -v pidof >/dev/null 2>&1 && pidof gnome-screensaver >/dev/null 2>&1; then
    exec gnome-screensaver-command --lock
fi
if command -v slock >/dev/null 2>&1; then
    exec slock "$@"
fi
if command -v xlock >/dev/null 2>&1; then
    exec xlock "$@"
fi
if command -v i3lock >/dev/null 2>&1; then
    exec i3lock -d
fi
if command -v slimlock >/dev/null 2>&1; then
    exec slimlock
fi
if command -v xscreensaver >/dev/null 2>&1 && command -v xscreensaver-command >/dev/null 2>&1; then
    xscreensaver -nosplash >/dev/null 2>&1 &
    sleep 1
    exec xscreensaver-command -lock
fi

printf '%s\n' 'luxelock: no supported screen locker is available' >&2
exit 1
