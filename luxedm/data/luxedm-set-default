set -eu

if [ "$(id -u)" -ne 0 ]; then
    if command -v pkexec >/dev/null 2>&1; then
        exec pkexec /usr/sbin/luxedm-set-default "$@"
    fi
    printf '%s\n' 'luxedm-set-default requires root privileges.' >&2
    exit 1
fi
if ! command -v systemctl >/dev/null 2>&1; then
    printf '%s\n' 'luxedm-set-default requires systemd.' >&2
    exit 1
fi

install -d -m 0755 /etc/X11
default_file=/etc/X11/default-display-manager
temporary=$(mktemp /etc/X11/.luxedm-default-display-manager.XXXXXX)
trap 'rm -f "$temporary"' EXIT HUP INT TERM
printf '%s\n' /usr/bin/luxedm > "$temporary"
chmod 0644 "$temporary"
chown root:root "$temporary"
mv -fT "$temporary" "$default_file"
trap - EXIT HUP INT TERM
if command -v debconf-communicate >/dev/null 2>&1; then
    printf '%s\n' \
        'set shared/default-x-display-manager luxedm' \
        'fset shared/default-x-display-manager seen true' |
        debconf-communicate luxedm >/dev/null 2>&1 || true
fi
systemctl daemon-reload
systemctl enable --force luxedm.service
printf '%s\n' 'LuxeDM will be the display manager after the next reboot.'
