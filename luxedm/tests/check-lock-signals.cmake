# Supplement the behavioral lock-protection test with production wiring checks.
file(READ "${SRC}/src/lock.cpp" lock)
file(READ "${SRC}/src/panel.cpp" panel)
file(READ "${SRC}/src/app.cpp" app)
if(lock MATCHES "execv|execl|execve")
  message(FATAL_ERROR "the locker must retain its live X connection, not re-execute")
endif()
if(NOT lock MATCHES "InstallLockSignalPolicy" OR NOT lock MATCHES "cover_guard.start")
  message(FATAL_ERROR "production locker must install signal and geometry protection")
endif()
if(NOT lock MATCHES "SetFailureHandler" OR NOT lock MATCHES "hold_lock_on_panel_failure")
  message(FATAL_ERROR "panel setup failures must keep the lock held")
endif()
if(NOT panel MATCHES "FailureHandler" OR NOT panel MATCHES "fail_panel")
  message(FATAL_ERROR "panel failures must route through the fail-closed handler")
endif()
if(NOT app MATCHES "luxedm_signal_pending" OR NOT app MATCHES "installSignalHandler")
  message(FATAL_ERROR "greeter signal handling must defer cleanup to the main loop")
endif()
