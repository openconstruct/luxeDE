<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
	<schema path="/org/luxe/shotty/" id="org.luxe.Shotty">
		<key name="area" type="i">
			<range min="0" max="2"/>
			<default>0</default>
		</key>
		<key name="delay-value" type="i">
			<range min="1" max="100"/>
			<default>1</default>
		</key>
		<key name="delay-disable" type="b">
			<default>true</default>
		</key>
		<key name="include-cursor" type="b">
			<default>false</default>
		</key>
		<key name="include-decorations" type="b">
			<default>false</default>
		</key>
		<key name="action-save" type="b">
			<default>true</default>
		</key>
		<key name="action-copy" type="b">
			<default>false</default>
		</key>
		<key name="action-open" type="b">
			<default>false</default>
		</key>
		<key name="action" type="s">
			<choices>
				<choice value="save"/>
				<choice value="copy"/>
				<choice value="open"/>
			</choices>
			<default>'save'</default>
		</key>
	</schema>
</schemalist>
